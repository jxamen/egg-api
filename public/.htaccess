RewriteEngine On
# /api 접두 — kkokkofarm.j-curve.co.kr/api/... 도메인 통합 경로. 무접두 경로도 병행 유지(구버전 앱).
RewriteRule ^api/(.*)$       /$1               [L]
RewriteRule ^ads/ssv/?$      /ads/ssv.php      [L]
RewriteRule ^ads/pending/?$  /ads/pending.php  [L]
RewriteRule ^ads/claim/?$    /ads/claim.php    [L]
RewriteRule ^shop/goods/?$   /shop/goods.php   [L]
RewriteRule ^shop/order/?$   /shop/order.php   [L]
RewriteRule ^ops/?$          /ops.php          [L]
RewriteRule ^admin/data/?$   /admin/data.php   [L]
# KICA(KIAP) 간편인증 — /kiap/* (SNS 로그인 /auth/* 와 네임스페이스 분리)
RewriteRule ^kiap/status/?$   /kiap/status.php   [L]
RewriteRule ^kiap/page/?$     /kiap/page.php     [L]
RewriteRule ^kiap/callback/?$ /kiap/callback.php [L]
RewriteRule ^kiap/result/?$   /kiap/result.php   [L]
# SNS 로그인 — /auth/* 전부를 auth.php 가 받는다(act 파라미터)
RewriteRule ^auth/(.+)$       /auth.php?act=$1   [L,QSA]
# 약관·개인정보처리방침 — 구글 OAuth 동의 화면·App Store 심사·네이버 검수가 공개 URL 을 요구한다
RewriteRule ^legal/privacy/?$ /legal/privacy.php [L]
RewriteRule ^legal/terms/?$   /legal/terms.php   [L]

